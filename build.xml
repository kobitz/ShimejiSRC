<?xml version="1.0" encoding="UTF-8" ?>
<project name="Shimeji-ee" basedir="." default="jar">

	<property name="version" value="1.9" />

	<target name="clean">
		<delete dir="target" />
		<mkdir dir="target" />
	</target>

	<target name="compile" depends="clean">
		<mkdir dir="target/classes" />
		<javac destdir="target/classes" release="17" debug="yes" optimize="yes" encoding="UTF-8">
			<src path="src"/>
			<src path="src_win"/>
			<src path="src_generic"/>
			<src path="src_virtual"/>
			<classpath>
				<fileset dir="lib" includes="*.jar" />
			</classpath>
		</javac>
	</target>

	<target name="jar" depends="compile">
		<!-- Fat jar: merges EVERY jar in lib/ into the output, so only keep jars the code actually uses. -->
		<jar destfile="target/Shimeji-ee.jar" manifest="MANIFEST.MF">
			<fileset dir="target/classes" />
			<zipgroupfileset dir="lib" includes="*.jar" />
		</jar>
	</target>

	<!-- The upstream Shimeji-ee "zip" / "zip_package" (Calm/Professional/Mischievous) targets were removed:
	     they referenced files that no longer exist and predate this fork. Release bundles are assembled
	     by allowlist from the install folder (see CLAUDE.md > Distribution / Releases). -->
</project>
