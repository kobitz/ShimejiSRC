				<Pose Image="/stand7.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" />
			</Animation>
		</Action>
		
		<!-- HOTSPOT 2 - Touch the Wood Logs -->
		<Action Name="FireOff!" Type="Sequence" Loop="false">
			<ActionReference Name="Mute"/>
			<ActionReference Name="FireOff!Action" Duration="14" />
		</Action>
		
		<Action Name="FireOff!Action" Type="Embedded" Class="com.group_finity.mascot.action.Transform" 
			TransformMascot="CampfireReactive" TransformBehavior="StandUp">
			<Animation>
				<Pose Image="/fireoff1.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" Sound="/flameOff.wav" Volume="-15"/>
				<Pose Image="/fireoff2.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" />
