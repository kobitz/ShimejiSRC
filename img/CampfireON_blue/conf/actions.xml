				<Pose Image="/fireoff7.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" />
			</Animation>
		</Action>
		
		<Action Name="BlueFireOff!Action" Type="Embedded" Class="com.group_finity.mascot.action.Transform" 
			TransformMascot="CampfireON" TransformBehavior="StandUp">
			<Animation>
				<Pose Image="/fireon4.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" Sound="/flameOn.wav" Volume="-15" />
				<Pose Image="/fireon5.png" ImageAnchor="64,128" Velocity="0,0" Duration="2" />
			</Animation>
		</Action>
		
		<Action Name="BlueFireOff!" Type="Sequence" Loop="false">
			<ActionReference Name="BlueFireOff!Action" Duration="10" />
		</Action>


