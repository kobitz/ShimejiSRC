		<!-- Standing -->
		
		<Action Name="Stand" Type="Stay" BorderType="Floor" Draggable="false" Affordance="CoolerBoost">
			<Animation>
				<Pose Image="/stand1.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" Sound="/FireplaceCrackingSounds.wav" Volume="-15" />
				<Pose Image="/stand2.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				<Pose Image="/stand3.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				<Pose Image="/stand4.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				<Pose Image="/stand5.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				<Pose Image="/stand6.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				<Pose Image="/stand7.png" ImageAnchor="64,128" Velocity="0,0" Duration="3" />
				
				<Hotspot Shape="Rectangle" Origin="0,0" Size="128,108" Behavior="Add a Branch!" />
				<Hotspot Shape="Rectangle" Origin="54,103" Size="20,20" Behavior="FireOff!" />
			</Animation>
		</Action>
		

		<!-- HOTSPOT 1 - Touch the Fire -->
		<Action Name="Add a Branch!" Type="Sequence" Loop="false">
			<ActionReference Name="Add a Branch!Action" Duration="54" />
